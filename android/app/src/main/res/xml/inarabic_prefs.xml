<?xml version="1.0" encoding="utf-8"?>
<!-- In Arabic settings, in the order you need them: what to translate, the screens, the look, where to read,
     then everything else folded under "متقدم". -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory app:title="١. الترجمة" app:iconSpaceReserved="false">
        <SwitchPreference app:key="ia_enabled" app:defaultValue="true" app:iconSpaceReserved="false"
            app:title="الترجمة شغالة" app:summary="تترجم وقت اللعب من الجوال" />
        <ListPreference app:key="ia_mode" app:title="وش أترجم؟" app:defaultValue="menus" app:iconSpaceReserved="false"
            app:entries="@array/ia_mode_names" app:entryValues="@array/ia_mode_values" app:useSimpleSummaryProvider="true" />
        <ListPreference app:key="ia_dialog_source" app:title="مصدر الحوار" app:defaultValue="screen" app:iconSpaceReserved="false"
            app:entries="@array/ia_dialog_source_names" app:entryValues="@array/ia_dialog_source_values" app:useSimpleSummaryProvider="true" />
        <Preference app:key="ia_game_pick" app:title="اللعبة" app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="النظام الجديد" app:iconSpaceReserved="false">
        <ListPreference app:key="ia_system" app:title="النظام" app:defaultValue="old" app:iconSpaceReserved="false"
            app:entries="@array/ia_system_names" app:entryValues="@array/ia_system_values" app:useSimpleSummaryProvider="true" />
        <ListPreference app:key="ia_new_translator" app:title="مترجم النظام الجديد" app:defaultValue="haiku" app:iconSpaceReserved="false"
            app:entries="@array/ia_new_translator_names" app:entryValues="@array/ia_new_translator_values" app:useSimpleSummaryProvider="true" />
        <ListPreference app:key="ia_swears" app:title="الكلام البذيء" app:defaultValue="raw" app:iconSpaceReserved="false"
            app:entries="@array/ia_swears_names" app:entryValues="@array/ia_swears_values" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="ia_haiku_key" app:title="مفتاح Haiku" app:iconSpaceReserved="false" />
        <EditTextPreference app:key="ia_gemini_key" app:title="مفتاح Gemini (من Google AI Studio)" app:iconSpaceReserved="false" />
        <EditTextPreference app:key="ia_google_key" app:title="مفتاح قوقل الرسمي" app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="٢. الشاشة (التلفزيون)" app:iconSpaceReserved="false">
        <Preference app:key="ia_pair_scan" app:title="اربط شاشة بالباركود" app:iconSpaceReserved="false" />
        <Preference app:key="ia_test" app:title="اعرض سطر تجريبي على الشاشة" app:iconSpaceReserved="false"
            app:summary="جرّب الحجم والمكان واللون وأنت تشوف التلفزيون" />
        <SwitchPreference app:key="ia_show_on_phone" app:defaultValue="true" app:iconSpaceReserved="false"
            app:title="اعرض الترجمة على الجوال بعد" />
    </PreferenceCategory>

    <PreferenceCategory app:title="٣. شكل الحوار" app:iconSpaceReserved="false" app:initialExpandedChildrenCount="5">
        <ListPreference app:key="ia_dialog_look" app:title="تنسيق الحوار" app:defaultValue="box" app:iconSpaceReserved="false"
            app:entries="@array/ia_look_names" app:entryValues="@array/ia_look_values" app:useSimpleSummaryProvider="true" />
        <ListPreference app:key="ia_box_color" app:title="لون خلفية الحوار" app:defaultValue="#000000" app:iconSpaceReserved="false"
            app:entries="@array/ia_box_color_names" app:entryValues="@array/ia_box_color_values" app:useSimpleSummaryProvider="true" />
        <SeekBarPreference app:key="ia_box_opacity" app:title="عتامة خلفية الحوار (%)" app:iconSpaceReserved="false"
            app:defaultValue="85" android:max="100" app:min="10" app:showSeekBarValue="true" />
        <SeekBarPreference app:key="ia_text_scale" app:title="حجم خط الحوار (100 = نفس حجم الإنجليزي)" app:iconSpaceReserved="false"
            app:defaultValue="100" android:max="200" app:min="50" app:showSeekBarValue="true" />
        <SeekBarPreference app:key="ia_tv_shift" app:title="ارفع أو نزّل الحوار (%)" app:iconSpaceReserved="false"
            app:defaultValue="0" android:max="10" app:min="-10" app:showSeekBarValue="true" />
        <ListPreference app:key="ia_position" app:title="مكان الحوار" app:defaultValue="auto" app:iconSpaceReserved="false"
            app:entries="@array/ia_pos_names" app:entryValues="@array/ia_pos_values" app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="٤. شكل القوائم" app:iconSpaceReserved="false" app:initialExpandedChildrenCount="5">
        <ListPreference app:key="ia_menu_look" app:title="تنسيق القوائم" app:defaultValue="box" app:iconSpaceReserved="false"
            app:entries="@array/ia_look_names" app:entryValues="@array/ia_look_values" app:useSimpleSummaryProvider="true" />
        <ListPreference app:key="ia_menu_box_color" app:title="لون خلفية القوائم" app:defaultValue="#000000" app:iconSpaceReserved="false"
            app:entries="@array/ia_box_color_names" app:entryValues="@array/ia_box_color_values" app:useSimpleSummaryProvider="true" />
        <SeekBarPreference app:key="ia_menu_box_opacity" app:title="عتامة خلفية القوائم (%)" app:iconSpaceReserved="false"
            app:defaultValue="85" android:max="100" app:min="10" app:showSeekBarValue="true" />
        <SeekBarPreference app:key="ia_menu_scale" app:title="حجم خط القوائم (100 = نفس حجم الإنجليزي)" app:iconSpaceReserved="false"
            app:defaultValue="100" android:max="200" app:min="50" app:showSeekBarValue="true" />
        <SeekBarPreference app:key="ia_menu_shift" app:title="ارفع أو نزّل القوائم (%)" app:iconSpaceReserved="false"
            app:defaultValue="0" android:max="10" app:min="-10" app:showSeekBarValue="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="٥. صوت الترجمة (دبلجة)" app:iconSpaceReserved="false">
        <SwitchPreference app:key="ia_voice" app:defaultValue="false" app:iconSpaceReserved="false"
            app:title="صوت الترجمة" app:summary="يقول الحوار بالعربي أول ما يترجمه. نزّل صوت الحوار في إعدادات اللعبة شوي (لا تقفله)" />
        <ListPreference app:key="ia_voice_out" app:title="وين تسمع الصوت" app:defaultValue="tv" app:iconSpaceReserved="false"
            app:entries="@array/ia_voice_out_names" app:entryValues="@array/ia_voice_out_values" app:useSimpleSummaryProvider="true" />
        <SwitchPreference app:key="ia_voice_auto_rate" app:defaultValue="false" app:iconSpaceReserved="false"
            app:title="ضبط السرعة تلقائي" app:summary="كل جملة بنفس طول الجملة الإنجليزية (يتعلم سرعة كلام اللعبة)" />
        <SeekBarPreference app:key="ia_voice_rate" app:title="سرعة الدبلجة (100 = عادي)" app:iconSpaceReserved="false"
            app:defaultValue="100" android:max="200" app:min="50" app:showSeekBarValue="true" />
        <ListPreference app:key="ia_voice_who" app:title="الأصوات" app:defaultValue="auto" app:iconSpaceReserved="false"
            app:entries="@array/ia_voice_who_names" app:entryValues="@array/ia_voice_who_values" app:useSimpleSummaryProvider="true" />
        <ListPreference app:key="ia_voice_dialect" app:title="لهجة الكلام" app:defaultValue="sa" app:iconSpaceReserved="false"
            app:entries="@array/ia_voice_dialect_names" app:entryValues="@array/ia_voice_dialect_values" app:useSimpleSummaryProvider="true" />
        <Preference app:key="ia_voice_people" app:title="الشخصيات وأصواتها" app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="٦. عام" app:iconSpaceReserved="false" app:initialExpandedChildrenCount="2">
        <SwitchPreference app:key="ia_clock" app:defaultValue="false" app:iconSpaceReserved="false"
            app:title="اعرض الساعة في اللعبة" app:summary="ساعة جوالك، صغيرة فوق يسار على التلفزيون" />
        <Preference app:key="ia_zones_info" app:title="مربعات القراءة" app:iconSpaceReserved="false"
            app:summary="من البث: المس الشاشة ← «📐 المربعات». مربع على الحوار، ومربعات للقوائم إذا تبي." />
        <SeekBarPreference app:key="ia_tv_zoom" app:title="مطابقة التلفزيون: تكبير (%)" app:iconSpaceReserved="false"
            app:summary="إذا الترجمة على التلفزيون أقرب للوسط من الإنجليزي، زِده"
            app:defaultValue="0" android:max="15" app:min="0" app:showSeekBarValue="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="٧. الجلسات والذاكرة" app:iconSpaceReserved="false">
        <Preference app:key="ia_summary" app:title="سجل الجلسات والملخص" app:iconSpaceReserved="false"
            app:summary="حوار كل جلسة، وملخص يذكّرك وين وقفت" />
        <Preference app:key="ia_memory" app:title="ذاكرة الترجمة" app:iconSpaceReserved="false" />
        <Preference app:key="ia_diag" app:title="شارك سجل التشخيص" app:iconSpaceReserved="false"
            app:summary="وش قرأ البرنامج ووش عرض آخر دقائق. أرسله إذا شفت ترجمة غريبة" />
        <Preference app:key="ia_diag_upload" app:title="ارفع السجل الحين" app:iconSpaceReserved="false"
            app:summary="يرتفع لحاله كل ١٠ دقايق وأنت تلعب، ولمن يقفل البث" />
    </PreferenceCategory>

    <PreferenceCategory app:title="متقدم" app:iconSpaceReserved="false" app:initialExpandedChildrenCount="0">
        <EditTextPreference app:key="ia_diag_token" app:title="مفتاح رفع السجل (قيت هب)" app:iconSpaceReserved="false" />
        <Preference app:key="ia_address" app:title="بدون باركود: عنوان الجوال ورمز الاقتران" app:summary=" " app:iconSpaceReserved="false" />
        <Preference app:key="ia_pair_forget" app:title="ألغِ ربط كل الشاشات" app:iconSpaceReserved="false" />
        <SeekBarPreference app:key="ia_read_every" app:title="سرعة القراءة (ملّي ثانية)" app:iconSpaceReserved="false"
            app:defaultValue="300" android:max="1000" app:min="150" app:showSeekBarValue="true" />
        <SwitchPreference app:key="ia_paddle" app:defaultValue="true" app:iconSpaceReserved="false"
            app:title="قارئ ثاني للأسطر غير الواضحة" app:summary="أدق، يستهلك بطارية أكثر شوي" />
        <SwitchPreference app:key="ia_center_only" app:defaultValue="true" app:iconSpaceReserved="false"
            app:title="افصل الأزرار عن الحوار" app:summary="النص القصير على طرف مربع الحوار يُترجم مكانه" />
        <SwitchPreference app:key="ia_auto_reconnect" app:defaultValue="true" app:iconSpaceReserved="false"
            app:title="أعد الاتصال تلقائياً إذا انقطع البث" />
    </PreferenceCategory>
</PreferenceScreen>

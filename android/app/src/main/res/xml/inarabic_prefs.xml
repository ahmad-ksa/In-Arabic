<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory app:title="الشاشة">
        <Preference app:key="ia_address" app:title="عنوان الجوال ورمز الاقتران"
            app:summary=" " />
        <Preference app:key="ia_test" app:title="اعرض سطرًا تجريبيًا على الشاشة"
            app:summary="جرّب الحجم والمكان واللون وأنت تنظر إلى الشاشة" />
        <SeekBarPreference app:key="ia_text_scale" app:title="حجم الخط (%)"
            app:defaultValue="100" android:max="200" app:min="50" app:showSeekBarValue="true" />
        <ListPreference app:key="ia_color" app:title="لون الخط" app:defaultValue="#FFFFFF"
            app:entries="@array/ia_color_names" app:entryValues="@array/ia_color_values" app:useSimpleSummaryProvider="true" />
        <SwitchPreference app:key="ia_bold" app:defaultValue="true" app:title="خط عريض" />
        <ListPreference app:key="ia_position" app:title="مكان الترجمة" app:defaultValue="auto"
            app:entries="@array/ia_pos_names" app:entryValues="@array/ia_pos_values" app:useSimpleSummaryProvider="true" />
        <SwitchPreference app:key="ia_cover" app:defaultValue="true"
            app:title="غطِّ الترجمة الإنجليزية الأصلية" />
        <SeekBarPreference app:key="ia_box_opacity" app:title="عتامة خلفية الترجمة (%)"
            app:defaultValue="85" android:max="100" app:min="0" app:showSeekBarValue="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="الترجمة">
        <SwitchPreference app:key="ia_enabled" app:defaultValue="true"
            app:title="ترجمة النصوص الإنجليزية" app:summary="تعمل أثناء اللعب من الجوال" />
        <Preference app:key="ia_download_model" app:title="تنزيل نموذج الترجمة المجاني"
            app:summary="مرة واحدة (حوالي 30 ميغا) — بعدها تعمل الترجمة الفورية بدون إنترنت" />
        <SwitchPreference app:key="ia_ai_enabled" app:defaultValue="false"
            app:title="ترجمة أدق بالذكاء الاصطناعي"
            app:summary="تظهر الترجمة المجانية فورًا ثم تُستبدل بترجمة الذكاء الاصطناعي" />
        <EditTextPreference app:key="ia_ai_key" app:title="مفتاح API" app:dependency="ia_ai_enabled" />
        <EditTextPreference app:key="ia_ai_base" app:title="عنوان الخدمة" app:dependency="ia_ai_enabled"
            app:defaultValue="https://api.openai.com/v1" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="ia_ai_model" app:title="النموذج" app:dependency="ia_ai_enabled"
            app:defaultValue="gpt-4o-mini" app:useSimpleSummaryProvider="true" />
        <Preference app:key="ia_memory" app:title="ذاكرة الترجمة" />
        <Preference app:key="ia_summary" app:title="ملخص قصة آخر جلسة"
            app:summary="يلخّص ما حدث ويذكّرك أين توقفت (أدق مع مفتاح الذكاء الاصطناعي)" />
    </PreferenceCategory>

    <PreferenceCategory app:title="قراءة النص من الصورة">
        <SeekBarPreference app:key="ia_area_top" app:title="بداية منطقة الترجمة (من أعلى الصورة %)"
            app:defaultValue="62" android:max="95" app:min="0" app:showSeekBarValue="true" />
        <SeekBarPreference app:key="ia_area_bottom" app:title="نهاية منطقة الترجمة (%)"
            app:defaultValue="97" android:max="100" app:min="10" app:showSeekBarValue="true" />
        <SeekBarPreference app:key="ia_read_every" app:title="سرعة القراءة (ملّي ثانية بين كل قراءة)"
            app:defaultValue="300" android:max="1000" app:min="150" app:showSeekBarValue="true" />
        <SwitchPreference app:key="ia_paddle" app:defaultValue="true"
            app:title="قارئ ثانٍ للأسطر غير الواضحة" app:summary="PaddleOCR: أدق مع الصورة الضعيفة، يستهلك بطارية أكثر قليلًا" />
        <SwitchPreference app:key="ia_show_on_phone" app:defaultValue="true"
            app:title="اعرض الترجمة على الجوال أيضًا" app:summary="اضغط على الترجمة في الجوال لتصحيحها" />
    </PreferenceCategory>

    <PreferenceCategory app:title="الصندوق الثاني (المهام والرسائل)">
        <SwitchPreference app:key="ia_box2" app:defaultValue="false"
            app:title="ترجم نصوصًا جانبية أيضًا" app:summary="منطقة ثانية من الصورة مثل الأهداف والرسائل" />
        <SeekBarPreference app:key="ia_box2_x" app:title="من اليسار (%)" app:dependency="ia_box2"
            app:defaultValue="2" android:max="95" app:min="0" app:showSeekBarValue="true" />
        <SeekBarPreference app:key="ia_box2_y" app:title="من الأعلى (%)" app:dependency="ia_box2"
            app:defaultValue="3" android:max="95" app:min="0" app:showSeekBarValue="true" />
        <SeekBarPreference app:key="ia_box2_w" app:title="العرض (%)" app:dependency="ia_box2"
            app:defaultValue="40" android:max="100" app:min="5" app:showSeekBarValue="true" />
        <SeekBarPreference app:key="ia_box2_h" app:title="الارتفاع (%)" app:dependency="ia_box2"
            app:defaultValue="22" android:max="100" app:min="5" app:showSeekBarValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
